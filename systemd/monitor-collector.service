[Unit]
Description=UMA central collector
Documentation=https://github.com/ruthvik2424/UMA-Monitoring-Tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/monitor-collector --config /etc/monitor-collector/config.toml
Restart=always
RestartSec=2
LimitNOFILE=131072
TimeoutStopSec=10

User=monitor-collector
Group=monitor-collector
StateDirectory=monitor-collector
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectSystem=strict
ReadWritePaths=/var/lib/monitor-collector
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
